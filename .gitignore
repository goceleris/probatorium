/bin/
/cmd/*/cmd
*.test
*.out
*.prof

# Top-level binaries produced by `go build ./...` for cmd/<name>/main.go
/runner
/loadgen
/observer
/conformance
/validator
/validator-checker
/validator-replay

/validation/refapp/auth_session_ratelimit/auth_session_ratelimit
/servers/celeris/celeris
/servers/chi/chi
/servers/echo/echo
/servers/fasthttp/fasthttp
/servers/fiber/fiber
/servers/gin/gin
/servers/hertz/hertz
/servers/iris/iris
/servers/stdhttp/stdhttp

# Bun-on-TS competitor adapters (wave 4b). Build outputs and the
# package manager's resolved-deps cache stay out of git so the
# always-latest deploy policy is enforced — every cluster deploy
# does a fresh `bun install` against upstream registry HEAD.
/servers/hono/node_modules/
/servers/hono/dist/
/servers/hono/bun.lock
/servers/hono/bun.lockb
/servers/elysia/node_modules/
/servers/elysia/dist/
/servers/elysia/bun.lock
/servers/elysia/bun.lockb

# Express (Node.js) competitor adapter. node runs src/ directly (no
# bundle), so only the resolved-deps cache and npm's lockfile stay out
# of git — every cluster deploy does a fresh `npm install` against the
# upstream registry, enforcing the always-latest policy.
/servers/express/node_modules/
/servers/express/package-lock.json

# Python adapter local-dev artefacts. The cluster builds the venv under
# {{ bench_root }}/competitors/<name>/.venv via the python ansible role
# — both the in-repo .venv and the bytecode caches are dev-only debris.
/servers/*/.venv/
__pycache__/
*.pyc
*.egg-info/

go.work
go.work.sum
.magefile/

/results/*

/tmp-staging/
servers/_docker/**/*.tar

# Rust adapter build artefacts (wave 4a). target/ holds intermediate
# objects + the compiled binary; Cargo.lock is regenerated on every
# build because the always-latest version policy means each cluster
# deploy resolves dependencies freshly via `cargo update`.
/servers/axum/target/
/servers/axum/Cargo.lock
/servers/ntex/target/
/servers/ntex/Cargo.lock

# Zig adapter build artefacts. zig-out/ holds the compiled binary and
# .zig-cache/ the incremental build cache; both are regenerated by
# `zig build -Doptimize=ReleaseFast` on every cluster deploy.
/servers/zig_zap/zig-out/
/servers/zig_zap/.zig-cache/

.idea/
.vscode/
.DS_Store
/validation/refapp/*/kitchen_sink

# Refapp local-build binaries (named after their dir slug)
/validation/refapp/kitchen_sink/kitchen_sink
/validation/refapp/auth_session_ratelimit/auth_session_ratelimit
/validation/refapp/auth_jwt_csrf/auth_jwt_csrf
/validation/refapp/driver_postgres/driver_postgres
/validation/refapp/driver_redis/driver_redis
/validation/refapp/driver_memcached/driver_memcached
/validation/refapp/observability/observability
/validation/refapp/static_swagger_proxy/static_swagger_proxy

# wave-6 native competitor adapters (actix/lithium/starlette/bunraw/httpzig/
# h2o/uws/fastify/express/vertx/netty + nbio). The cluster builds every
# artefact under bench_root; nothing here should be committed. Generic globs
# so a local validation build never dirties the tree.
/servers/*/target/
/servers/*/build/
/servers/*/node_modules/
/servers/*/dist/
/servers/*/zig-out/
/servers/*/.zig-cache/
/servers/**/__pycache__/
/servers/*/server
/servers/actix/target/
/servers/actix/Cargo.lock
