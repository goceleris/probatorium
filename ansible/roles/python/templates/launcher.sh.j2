#!/usr/bin/env bash
# Launcher for the {{ competitor_name }} python adapter.
#
# The orchestrator (servers.StartAdapter) execs this path with:
#     server -bind <host:port> [-engine h1|h2c]
# We translate that into a server invocation under the project venv.
#
# -engine selects the wire protocol:
#   h1 (or absent) → uvicorn fast path (knobs below).
#   h2c            → HTTP/2 cleartext, prior-knowledge, no TLS. uvicorn
#                    cannot speak HTTP/2, so we exec `python -m app.server
#                    -engine h2c`, which serves the same ASGI app under
#                    hypercorn. See app/server.py / pyproject.toml.
#
# Performance knobs (always on, h1 path):
#   --loop uvloop        — uvloop event loop (uvicorn[standard] dep)
#   --http httptools     — httptools parser (uvicorn[standard] dep)
#   --no-access-log      — log per-request line cost killed
#   --log-level warning  — uvicorn's default is info; we want quiet
#   --workers $(nproc)   — one worker per logical CPU (only valid in
#                          non-reload mode, which is implicit here)
#
# Free-threaded python: PYTHON_GIL=0 disabled — uvloop's C extension
# in current stable releases is NOT free-thread-safe (verify on next
# stable bump). Re-enable by adding `export PYTHON_GIL=0` below once
# uvloop ships a free-thread-safe build. TODO.
#
# After uvicorn binds, this script polls the bound address from the
# outside and prints `ready addr=<host:port>` ONCE to stdout. With
# multiple workers, uvicorn's lifespan runs per-worker, so a banner
# emitted from inside the app would print N times — the polling
# approach gives a single banner regardless of worker count.

set -euo pipefail

# Hardcoded paths because the launcher's $0 is the competitors/<slug>
# file under bench_root — the venv lives at a sibling top-level dir
# (python-venvs/<slug>) so we can't derive it from $0 portably.
VENV_DIR="{{ competitor_venv_path }}"
SRC_DIR="{{ competitor_src_path }}"
APP_TARGET="{{ competitor_module_target }}"

bind=""
engine="h1"
while [[ $# -gt 0 ]]; do
    case "$1" in
        -bind|--bind)
            bind="$2"
            shift 2
            ;;
        -bind=*|--bind=*)
            bind="${1#*=}"
            shift
            ;;
        -engine|--engine)
            engine="$2"
            shift 2
            ;;
        -engine=*|--engine=*)
            engine="${1#*=}"
            shift
            ;;
        *)
            shift
            ;;
    esac
done

if [[ -z "$bind" ]]; then
    bind="127.0.0.1:8080"
fi

if [[ -z "$engine" ]]; then
    engine="h1"
fi

# IPv6 literal handling: [::1]:8080 → host=::1 port=8080.
if [[ "$bind" =~ ^\[(.+)\]:([0-9]+)$ ]]; then
    host="${BASH_REMATCH[1]}"
    port="${BASH_REMATCH[2]}"
else
    host="${bind%:*}"
    port="${bind##*:}"
fi

export PYTHONUNBUFFERED=1
export PYTHONDONTWRITEBYTECODE=1
# Keep uvicorn from spinning up the watcher (which `uvicorn[standard]`
# pulls in via watchfiles); our launcher is one-shot.
export WATCHFILES_FORCE_POLLING=false

# Let python find the adapter package. The source tree was extracted
# read-only at SRC_DIR — we point PYTHONPATH at it so the venv's site-
# packages doesn't need an editable install.
export PYTHONPATH="${SRC_DIR}${PYTHONPATH:+:${PYTHONPATH}}"

# The launcher's external TCP probe (below) is the single source of the
# `ready addr=...` banner for BOTH engines. The h2c path runs
# `app.server`, which would otherwise print its own banner — suppress it
# so multi-banner parsing in the orchestrator stays correct.
export PROBATORIUM_SUPPRESS_READY=1

workers="$(nproc 2>/dev/null || echo 1)"

# Emit `ready addr=...` ONCE after uvicorn binds. Polls the TCP port
# in a tight loop until accept succeeds, then prints. The probe runs
# in the background; uvicorn keeps the foreground.
(
    for _ in $(seq 1 600); do
        if (exec 3<>/dev/tcp/"${host}"/"${port}") 2>/dev/null; then
            exec 3<&-
            exec 3>&-
            echo "ready addr=${host}:${port}"
            exit 0
        fi
        sleep 0.05
    done
) &
ready_probe=$!
# Detach so a uvicorn crash doesn't leave the probe orphaned past the
# parent's exit.
disown "$ready_probe" 2>/dev/null || true

case "${engine}" in
    h2c)
        # HTTP/2 cleartext (prior-knowledge, no TLS) under hypercorn.
        # uvicorn cannot speak HTTP/2, so route through the app entry
        # point, which selects hypercorn for -engine h2c. Single process
        # (hypercorn's asyncio.serve runs one worker); the GET-heavy bench
        # contract is the same app regardless of server.
        exec "${VENV_DIR}/bin/python" -m app.server \
            -bind "${host}:${port}" \
            -engine h2c
        ;;
    h1|"")
        exec "${VENV_DIR}/bin/python" -m uvicorn "${APP_TARGET}" \
            --host "${host}" \
            --port "${port}" \
            --workers "${workers}" \
            --loop uvloop \
            --http httptools \
            --no-access-log \
            --log-level warning
        ;;
    *)
        echo "fastapi launcher: unknown -engine '${engine}' (want h1|h2c)" >&2
        exit 2
        ;;
esac
