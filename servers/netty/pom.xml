<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    probatorium netty adapter — the raw JVM low-level baseline.

    A bare io.netty HTTP server: HttpServerCodec + a SimpleChannelInboundHandler
    over an epoll (Linux) / NIO event-loop group. No web framework, no router
    crate — a hand-written (method, path) match, so this column is the floor the
    JVM framework columns (if any are ever added) measure their abstraction cost
    against. Mirrors the spirit of the rust-hyper / go-gnet baselines.

    Build: a single shaded uber-jar (netty + this adapter) produced by
    maven-shade-plugin with a Main-Class manifest, so the bench launcher can
    `java -jar netty-adapter.jar -bind <addr>` with no classpath wiring.

    Netty version: pinned to the latest 4.2.x via the netty-bom. 4.2 graduated
    the io_uring transport and deprecated the per-transport EventLoopGroup
    classes in favour of MultiThreadIoEventLoopGroup(<Transport>IoHandler
    .newFactory()) — the adapter uses the new API exclusively.
  -->

  <groupId>io.goceleris.probatorium</groupId>
  <artifactId>netty-adapter</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Always-latest 4.2.x. Bump this single line to track upstream. -->
    <netty.version>4.2.17.Final</netty.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Core transport + the HTTP codec (HttpServerCodec, HttpObjectAggregator,
         DefaultFullHttpResponse, …). netty-codec-http transitively pulls the
         common/buffer/transport/codec modules. -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec-http</artifactId>
    </dependency>

    <!-- Linux epoll transport — split across two artifacts in Netty 4.2:

         1. netty-transport-classes-epoll: the pure-Java API (Epoll,
            EpollServerSocketChannel, EpollIoHandler, EpollChannelOption, …).
            Platform-independent, needed at COMPILE time. This is what the
            adapter imports; without it the io.netty.channel.epoll package does
            not exist on the classpath and compilation fails.
         2. netty-transport-native-epoll (classified, below): the native .so
            ONLY, needed at RUNTIME on Linux. The classified jar carries no
            Java classes, so declaring it alone is not enough to compile. -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-classes-epoll</artifactId>
    </dependency>

    <!-- Linux epoll native .so: the high-performance event loop the adapter
         selects when available (the JVM analogue of celeris-epoll / go-gnet).
         The classifier picks the right native .so for the build host's arch; on
         the bench cluster the build runs ON the target node so the bundled
         native matches the node's libc/CPU. Falls back to NIO when epoll is
         absent (non-Linux dev box) — the native is loaded lazily via
         Epoll.isAvailable(), so its absence on a Mac is harmless. -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-native-epoll</artifactId>
      <!--
        Version pinned explicitly (not BOM-inherited): Maven keys
        dependencyManagement on (group, artifact, type, classifier), and the
        os-maven-plugin classifier (linux-x86_64 / linux-aarch_64 on the bench
        nodes, osx-aarch_64 on a dev Mac) does NOT always have a matching
        managed entry — a non-Linux classifier has no managed version at all,
        so the model build fails with "version is missing". Pinning to
        ${netty.version} resolves the version regardless of classifier. The
        native is only loaded at runtime on Linux (Epoll.isAvailable()); on a
        dev Mac NIO is used, so the missing osx native is harmless there.
      -->
      <version>${netty.version}</version>
      <classifier>${os.detected.classifier}</classifier>
    </dependency>
  </dependencies>

  <build>
    <finalName>netty-adapter</finalName>

    <extensions>
      <!-- Resolves ${os.detected.classifier} (linux-x86_64 / linux-aarch_64)
           so the correct epoll native artifact is pulled for the build host. -->
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
      </extension>
    </extensions>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <!-- Netty ships META-INF/io.netty.versions.properties and a few
                   service files in every module; merge them so the shaded jar
                   keeps a single coherent copy instead of clobbering. -->
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.goceleris.probatorium.netty.NettyServer</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/io.netty.versions.properties</resource>
                </transformer>
              </transformers>
              <!-- Drop signature files from any signed transitive jar; they
                   become invalid in an uber-jar and trip SecurityException. -->
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
