diff --git a/frameworks/celeris/main.go b/frameworks/celeris/main.go
new file mode 100644
index 0000000..d5a7233
--- /dev/null
+++ b/frameworks/celeris/main.go
@@ -0,0 +1,320 @@
+// HttpArena entry for celeris (https://github.com/goceleris/celeris).
+//
+// Two engines serve this entry, and the README says so:
+//   - 8080 (h1 + WebSocket) and 8082 (h2c prior knowledge) run on celeris's
+//     default Adaptive engine (io_uring/epoll on Linux).
+//   - 8081 (HTTP/1.1 over TLS) and 8443 (h2 over TLS) run on celeris's std
+//     engine behind a crypto/tls listener, because the native engines have no
+//     TLS (celeris README, "TLS"). Those rows measure the std engine.
+package main
+
+import (
+	"bytes"
+	"crypto/tls"
+	_ "embed"
+	"encoding/json"
+	"html/template"
+	"log"
+	"net"
+	"os"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/goceleris/celeris"
+	"github.com/goceleris/celeris/driver/postgres"
+	"github.com/goceleris/celeris/middleware/compress"
+	"github.com/goceleris/celeris/middleware/static"
+	"github.com/goceleris/celeris/middleware/websocket"
+)
+
+type Rating struct {
+	Score int `json:"score"`
+	Count int `json:"count"`
+}
+
+type DatasetItem struct {
+	ID       int      `json:"id"`
+	Name     string   `json:"name"`
+	Category string   `json:"category"`
+	Price    int      `json:"price"`
+	Quantity int      `json:"quantity"`
+	Active   bool     `json:"active"`
+	Tags     []string `json:"tags"`
+	Rating   Rating   `json:"rating"`
+}
+
+type ProcessedItem struct {
+	DatasetItem
+	Total int `json:"total"`
+}
+
+type ProcessResponse struct {
+	Items []ProcessedItem `json:"items"`
+	Count int             `json:"count"`
+}
+
+// jsonbText receives a JSONB column through database/sql's Scanner contract
+// and writes it back out as raw JSON. Scanning a jsonb cell straight into a
+// *[]byte or *string hands back the binary wire form with its leading version
+// byte (0x01) on celeris v1.5.12-0.20261120120335-fe2b5be71ebc, while the
+// Scanner path decodes it correctly.
+type jsonbText []byte
+
+func (j *jsonbText) Scan(v any) error {
+	switch b := v.(type) {
+	case []byte:
+		*j = append((*j)[:0], b...)
+	case string:
+		*j = append((*j)[:0], b...)
+	default:
+		*j = (*j)[:0]
+	}
+	return nil
+}
+
+func (j jsonbText) MarshalJSON() ([]byte, error) {
+	if len(j) == 0 {
+		return []byte("[]"), nil
+	}
+	return j, nil
+}
+
+// DBItem is one async-db row. tags is a JSONB column, passed through as raw JSON.
+type DBItem struct {
+	ID       int       `json:"id"`
+	Name     string    `json:"name"`
+	Category string    `json:"category"`
+	Price    int       `json:"price"`
+	Quantity int       `json:"quantity"`
+	Active   bool      `json:"active"`
+	Tags     jsonbText `json:"tags"`
+	Rating   Rating    `json:"rating"`
+}
+
+type DBResponse struct {
+	Items []DBItem `json:"items"`
+	Count int      `json:"count"`
+}
+
+type Fortune struct {
+	ID      int
+	Message string
+}
+
+var (
+	dataset []DatasetItem
+	pool    *postgres.Pool
+
+	//go:embed fortunes.html
+	fortunesSrc string
+	fortunesTpl = template.Must(template.New("fortunes").Parse(fortunesSrc))
+)
+
+// A missing or unreadable dataset leaves the list empty, the server still starts.
+func loadDataset() {
+	path := os.Getenv("DATASET_PATH")
+	if path == "" {
+		path = "/data/dataset.json"
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return
+	}
+	_ = json.Unmarshal(data, &dataset)
+}
+
+func baseline(c *celeris.Context) error {
+	sum := c.QueryInt("a", 0) + c.QueryInt("b", 0)
+	if c.Method() == "POST" {
+		if n, err := strconv.Atoi(strings.TrimSpace(string(c.Body()))); err == nil {
+			sum += n
+		}
+	}
+	return c.String(200, "%d", sum)
+}
+
+func pipeline(c *celeris.Context) error { return c.String(200, "ok") }
+
+// Registered with Route.Async(): the wait parks a goroutine, not a loop thread.
+func delay(c *celeris.Context) error {
+	ms, _ := c.ParamInt("ms")
+	if ms > 0 {
+		time.Sleep(time.Duration(ms) * time.Millisecond)
+	}
+	return c.String(200, "%d", ms)
+}
+
+func jsonItems(c *celeris.Context) error {
+	count, _ := c.ParamInt("count")
+	count = min(max(count, 0), len(dataset))
+	m := c.QueryInt("m", 1)
+	if m == 0 {
+		m = 1
+	}
+	items := make([]ProcessedItem, count)
+	for i := range items {
+		d := dataset[i]
+		items[i] = ProcessedItem{DatasetItem: d, Total: d.Price * d.Quantity * m}
+	}
+	return c.JSON(200, ProcessResponse{Items: items, Count: count})
+}
+
+func echo(c *celeris.Context) error {
+	return c.Blob(200, "application/octet-stream", c.Body())
+}
+
+const emptyItems = `{"items":[],"count":0}`
+
+func asyncDB(c *celeris.Context) error {
+	if pool == nil {
+		return c.Blob(200, "application/json", []byte(emptyItems))
+	}
+	lo, hi := c.QueryInt("min", 10), c.QueryInt("max", 50)
+	limit := min(max(c.QueryInt("limit", 50), 1), 50)
+	rows, err := pool.QueryContext(c.Context(),
+		"SELECT id, name, category, price, quantity, active, tags, rating_score, rating_count FROM items WHERE price BETWEEN $1 AND $2 LIMIT $3",
+		lo, hi, limit)
+	if err != nil {
+		return c.Blob(200, "application/json", []byte(emptyItems))
+	}
+	defer rows.Close()
+	items := make([]DBItem, 0, limit)
+	for rows.Next() {
+		var it DBItem
+		if err := rows.Scan(&it.ID, &it.Name, &it.Category, &it.Price, &it.Quantity,
+			&it.Active, &it.Tags, &it.Rating.Score, &it.Rating.Count); err != nil {
+			continue
+		}
+		items = append(items, it)
+	}
+	return c.JSON(200, DBResponse{Items: items, Count: len(items)})
+}
+
+func fortunes(c *celeris.Context) error {
+	if pool == nil {
+		return c.String(500, "database unavailable")
+	}
+	rows, err := pool.QueryContext(c.Context(), "SELECT id, message FROM fortune")
+	if err != nil {
+		return c.String(500, "query failed")
+	}
+	defer rows.Close()
+	list := make([]Fortune, 0, 201)
+	for rows.Next() {
+		var f Fortune
+		if err := rows.Scan(&f.ID, &f.Message); err != nil {
+			continue
+		}
+		list = append(list, f)
+	}
+	list = append(list, Fortune{ID: 0, Message: "Additional fortune added at request time."})
+	slices.SortFunc(list, func(a, b Fortune) int { return strings.Compare(a.Message, b.Message) })
+	var buf bytes.Buffer
+	buf.Grow(32 << 10)
+	if err := fortunesTpl.Execute(&buf, list); err != nil {
+		return c.String(500, "render failed")
+	}
+	return c.Blob(200, "text/html; charset=utf-8", buf.Bytes())
+}
+
+// WebSocket echo: every text frame comes back as it came.
+func wsEcho(conn *websocket.Conn) {
+	for {
+		mt, msg, err := conn.ReadMessageReuse()
+		if err != nil {
+			return
+		}
+		if err := conn.WriteMessage(mt, msg); err != nil {
+			return
+		}
+	}
+}
+
+// register installs every route on one server; each listener serves the same
+// application, only the engine and protocol in front of it change.
+//
+// The static profiles (static-h2, and static-tls if subscribed) are TLS profiles, so the static
+// middleware is installed on the TLS servers only: the cleartext hot paths do not pass through it.
+func register(s *celeris.Server, withStatic bool) {
+	if withStatic {
+		s.Use(static.New(static.Config{Root: "/data/static", Prefix: "/static", Compress: true}))
+	}
+	s.GET("/pipeline", pipeline)
+	s.GET("/baseline11", baseline)
+	s.POST("/baseline11", baseline)
+	s.GET("/baseline2", baseline)
+	s.GET("/delay/:ms", delay).Async()
+	s.GET("/json/:count", compress.New(), jsonItems)
+	s.POST("/echo", echo)
+	s.GET("/async-db", asyncDB).Async()
+	s.GET("/fortunes", fortunes).Async()
+	// A plain GET on /ws is not an upgrade: the middleware passes it on, the next handler refuses it.
+	s.GET("/ws", websocket.New(websocket.Config{Handler: wsEcho}), func(c *celeris.Context) error {
+		return celeris.NewHTTPError(426, "WebSocket upgrade required")
+	})
+}
+
+func openDB(srv *celeris.Server) {
+	url := os.Getenv("DATABASE_URL")
+	if url == "" {
+		return
+	}
+	budget := 256
+	if v, err := strconv.Atoi(os.Getenv("DATABASE_MAX_CONN")); err == nil && v > 0 {
+		budget = v
+	}
+	// The pool is sized from the harness's connection budget (DATABASE_MAX_CONN),
+	// less headroom for the superuser slots Postgres reserves.
+	p, err := postgres.Open(url, postgres.WithEngine(srv), postgres.WithMaxOpen(max(budget-8, 1)))
+	if err != nil {
+		log.Printf("postgres: %v", err)
+		return
+	}
+	pool = p
+}
+
+// serveTLS runs the application on the std engine behind a crypto/tls listener.
+func serveTLS(addr string, cert tls.Certificate, protos []string, proto celeris.Protocol) {
+	ln, err := net.Listen("tcp", addr)
+	if err != nil {
+		log.Printf("tls listen %s: %v", addr, err)
+		return
+	}
+	s := celeris.New(celeris.Config{Engine: celeris.Std, Protocol: proto})
+	register(s, true)
+	cfg := &tls.Config{Certificates: []tls.Certificate{cert}, NextProtos: protos, MinVersion: tls.VersionTLS12}
+	if err := s.StartWithListener(tls.NewListener(ln, cfg)); err != nil {
+		log.Printf("tls server %s: %v", addr, err)
+	}
+}
+
+func main() {
+	loadDataset()
+
+	// 8080: HTTP/1.1 and WebSocket on the default Adaptive engine.
+	main8080 := celeris.New(celeris.Config{Addr: ":8080"})
+	register(main8080, false)
+	openDB(main8080)
+
+	// 8082: HTTP/2 prior knowledge (h2c), HTTP/1.1 kept on the same port.
+	h2c := celeris.New(celeris.Config{Addr: ":8082", Protocol: celeris.Auto})
+	register(h2c, false)
+	go func() {
+		if err := h2c.Start(); err != nil {
+			log.Fatalf("h2c: %v", err)
+		}
+	}()
+
+	// 8081 (h1 over TLS) and 8443 (h2 over TLS) open only when the harness
+	// mounts /certs, which it does for the TLS and h2 profiles alone.
+	if cert, err := tls.LoadX509KeyPair("/certs/server.crt", "/certs/server.key"); err == nil {
+		go serveTLS(":8081", cert, []string{"http/1.1"}, celeris.HTTP1)
+		go serveTLS(":8443", cert, []string{"h2", "http/1.1"}, celeris.Auto)
+	}
+
+	if err := main8080.Start(); err != nil {
+		log.Fatalf("8080: %v", err)
+	}
+}
