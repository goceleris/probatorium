+{
+  "display_name": "celeris",
+  "language": "Go",
+  "type": "emerging",
+  "mode": "standard",
+  "completeness": {
+    "routing": true,
+    "middleware": true,
+    "request": true,
+    "response": true
+  },
+  "engine": "io_uring/epoll (adaptive); std on the TLS ports",
+  "description": "celeris, an HTTP engine and router for Go with an adaptive io_uring/epoll event loop. The cleartext rows (8080 HTTP/1.1 and WebSocket, 8082 h2c) run on celeris's default Adaptive engine; the TLS rows (8081 HTTP/1.1 over TLS, 8443 h2 over TLS) run on celeris's std engine behind a crypto/tls listener, because the io_uring and epoll engines have no TLS: those rows measure the std engine, not the headline engine. JSON through c.JSON, gzip/brotli through the compress middleware, static files through the static middleware, WebSocket through the websocket middleware, PostgreSQL through celeris's own driver/postgres pool, fortunes through html/template. No HTTP/3, no gRPC. Default configuration (GCPercent and busy polling stay off).",
+  "repo": "https://github.com/goceleris/celeris",
+  "website": "https://goceleris.dev",
+  "enabled": true,
+  "tests": [
+    "baseline",
+    "pipelined",
+    "limited-conn",
+    "async",
+    "latency-1m",
+    "latency-10k",
+    "json-comp",
+    "async-db",
+    "fortunes",
+    "baseline-h2c",
+    "json-h2c",
+    "echo-ws",
+    "echo-ws-pipeline",
+    "echo-ws-limited",
+    "json-tls",
+    "8gbit",
+    "baseline-h2",
+    "static-h2"
+  ],
+  "maintainers": []
+}
